{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "hypou.app" }],
      "destination": "/teste",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.hypou.app" }],
      "destination": "/teste",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
